# Local: copie para .env (ignorado pelo git).
# Produção (SPRING_PROFILES_ACTIVE=prod, já definido no Dockerfile): configure no painel da nuvem.

# Obrigatórias em produção
# Formato JDBC, sem usuário/senha na URL. URIs "postgres://user:pass@host/db" não são aceitas.
# Bancos gerenciados externos normalmente exigem ?sslmode=require no final.
# Alternativa: DATABASE_URL, no mesmo formato (usada somente se DB_URL não existir).
DB_URL=jdbc:postgresql://localhost:5433/doceflux
DB_USERNAME=postgres
DB_PASSWORD=change-me
# mínimo 32 bytes; gere um valor aleatório, ex.: openssl rand -base64 48
JWT_SECRET=change-me-minimum-32-bytes-long-secret
# Código de convite exigido em POST /api/auth/register. Não impede o arranque se faltar:
# ausente ou em branco = cadastro ABERTO a qualquer pessoa. Em produção, use um valor longo e aleatório
# (ex.: openssl rand -base64 32). Localmente, deixe vazio.
REGISTRATION_SECRET=
# Origens do frontend, separadas por vírgula. Padrão: http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Opcionais
# Padrão 8080 (a maioria das plataformas injeta automaticamente)
PORT=8080
# Validade do token em segundos. Padrão: 28800 (8h)
APP_JWT_EXPIRATION_SECONDS=28800
